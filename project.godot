; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sky Islands"
config/description="A 3D platformer across floating islands. Collect every fruit, dodge the traps, reach the exit."
config/tags=PackedStringArray("platformer")
run/main_scene="res://Scenes/UI/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0941176, 0.101961, 0.109804, 1)
boot_splash/show_image=false
config/icon="res://Assets/Textures/fruit_icon.png"

[autoload]

AudioManager="*res://Scenes/Audio/AudioManager.tscn"
GameManager="*res://Scripts/GameManager.gd"

[display]

window/size/always_on_top=true

[filesystem]

import/blender/enabled=false

